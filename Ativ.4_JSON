-- ATIVIDADE 4 - CONSULTAS MYSQL COM JSON 
 -- Baseando-se no banco de dados world_x, realize as seguintes consultas:

-- Consulta 1: Escreva uma consulta que retorne o nome do país e a expectativa de vida de todos os países que pertencem à América do Sul.
SELECT 
    JSON_EXTRACT(doc, "$.Name") AS nome_pais,
    JSON_EXTRACT(doc, "$.demographics.LifeExpectancy") AS expectativa_vida
FROM 
    countryinfo
WHERE 
    JSON_EXTRACT(doc, "$.geography.Region") = 'South America';
    
    SELECT * FROM countryinfo;

-- Consulta 2: Escreva uma consulta que liste todos os países onde o Produto Nacional Bruto (GNP) é maior que 500.000 e que possuam o idioma Inglês como um de seus idiomas oficiais.
SELECT  -- Corrigir
    JSON_EXTRACT(doc, "$.Name") AS nome_pais,
    JSON_EXTRACT(doc, "$.economy.GNP") AS produto_nacional_bruto,
    JSON_EXTRACT(doc, "$.languages") AS idiomas
FROM 
    countryinfo
WHERE 
    CAST(JSON_EXTRACT(doc, "$.economy.GNP") AS DECIMAL) > 500000
    AND JSON_EXTRACT(doc, "$.languages") LIKE '%English%';

#Agora, a partir do banco de dados empresa, realize as seguintes consultas:

-- Consulta 3: Desenvolva uma consulta que retorne o nome do funcionário e o conteúdo do campo JSON apenas para os funcionários com pelo menos um dependente do sexo Feminino.
SELECT * FROM tb_object_funcionario;

SELECT DISTINCT
    f.PRIMEIRO_NOME AS Nome_Funcionario,
    d.Parentesco,
    obj.JSON
FROM tb_funcionario AS f
INNER JOIN tb_object_funcionario AS obj 
    ON f.CPF = obj.CPF 
INNER JOIN JSON_TABLE(
    obj.JSON,
    '$.Dependentes[*]' 
    COLUMNS (
        Parentesco VARCHAR(100) PATH '$.Parentesco',
        
        Sexo VARCHAR(10) PATH '$.Sexo'
    )
) AS d 
WHERE d.Sexo = "F";


 /* Consulta 4: Utilizando a função JSON_TABLE, retorne todos os dependentes cadastrados no banco de dados. A consulta deve retornar: o nome, 
 -- parentesco e data de nascimento do dependente e o nome do funcionário. */
SELECT 
    f.PRIMEIRO_NOME AS Nome_Funcionario,
    d.Nome_Dependente,
    d.Parentesco,
    d.Data_Nascimento
FROM tb_funcionario AS f
INNER JOIN tb_object_funcionario AS obj 
    ON f.CPF = obj.CPF 
CROSS JOIN JSON_TABLE(
    obj.JSON,
    '$.Dependentes[*]' 
    COLUMNS (
        Nome_Dependente VARCHAR(255) PATH '$.Nome_Dependente',
        Parentesco VARCHAR(100) PATH '$.Parentesco',
        Data_Nascimento DATE PATH '$.Data_Nascimento'
    )
) AS d;

 
 
